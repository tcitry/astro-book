---
import type { ArticleMetadata } from '../presentation';
interface Props extends ArticleMetadata {}
const { date, tags = [], image } = Astro.props;
---
{date && <h5><time class="whitespace-nowrap" datetime={date.value}>{date.label}</time></h5>}
{tags.length > 0 && (
  <div class="flex flex-wrap gap-x-1 gap-y-0.5">
    {tags.map((tag, index) => <span class="max-w-full [overflow-wrap:anywhere]"><a href={tag.href}>{tag.label}</a>{index < tags.length - 1 && ','}</span>)}
  </div>
)}
{image && <p><img src={image.src} alt={image.alt} loading="lazy" /></p>}
<slot />
