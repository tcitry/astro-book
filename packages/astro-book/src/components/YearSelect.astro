---
interface Props { items: { label: string; value: string }[]; selected?: string; label?: string; }
const { items, selected, label = 'Timeline year' } = Astro.props;
---
<nav class="timeline-year-nav"><select id="timeline-year-select" class="timeline-year-select" aria-label={label} data-book-year-select>{items.map((item) => <option value={item.value} selected={item.value === selected}>{item.label}</option>)}</select></nav>
<script>
  document.querySelectorAll<HTMLSelectElement>('[data-book-year-select]').forEach((select) => select.addEventListener('change', () => {
    const destination = new URL(select.value, location.href);
    if (['http:', 'https:'].includes(destination.protocol)) location.href = destination.href;
  }));
</script>
