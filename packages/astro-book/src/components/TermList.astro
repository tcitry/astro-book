---
import type { TermItem } from '../presentation';
interface Props { items: TermItem[]; title?: string; total?: number; }
const { items, title, total } = Astro.props;
---
<ul><li class="book-section-flat">{title && <strong>{title}{total !== undefined && <sup>{total}</sup>}</strong>}<ul>{items.map((item) => <li class="flex justify-between"><a href={item.href} class:list={{ 'highlight-toc text-[#8250df]!': item.active }} aria-current={item.active ? 'page' : undefined}>{item.label}</a>{item.count !== undefined && <span class="py-[.5em]">{item.count}</span>}</li>)}</ul></li></ul>
