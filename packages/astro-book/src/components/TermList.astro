---
import type { TermItem } from '../presentation';
import styles from '../styles/Navigation.module.css';
interface Props { items: TermItem[]; title?: string; total?: number; }
const { items, title, total } = Astro.props;
---
<ul class:list={["m-0 list-none p-0", styles.tree]}><li class:list={["book-section-flat relative my-4", styles.flat]}>{title && <strong>{title}{total !== undefined && <sup>{total}</sup>}</strong>}<ul class="m-0 list-none p-0 ps-0!">{items.map((item) => <li class="relative flex justify-between"><a href={item.href} class:list={['flex py-[.5em] transition-opacity duration-100 hover:opacity-50', { 'highlight-toc text-[#8250df]!': item.active }]} aria-current={item.active ? 'page' : undefined}>{item.label}</a>{item.count !== undefined && <span class="py-[.5em]">{item.count}</span>}</li>)}</ul></li></ul>
