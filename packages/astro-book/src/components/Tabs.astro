---
import type { Link, BadgeData } from '../presentation';
import Badge from './Badge.astro';
interface Props { items: (Link & { badge?: BadgeData })[]; current?: string; }
const { items, current } = Astro.props;
---
<div>{items.map((item, index) => <>{index > 0 && ' / '}{item.badge && <><Badge {...item.badge} />{' '}</>}{item.href === current ? <span class="text-[darkgrey]" aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}</>)}</div>
