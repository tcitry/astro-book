---
import type { BadgeData } from '../presentation';
interface Props extends BadgeData {}
const { label, href, class: className = '', title, leadingSpace = false, trailingSpace = false, unstyled = false } = Astro.props;
---
{leadingSpace && ' '}<span class:list={['inline-flex items-center whitespace-nowrap leading-[1.15]', !unstyled && 'title-label', className]} title={title}>{href ? <a href={href}>{label}</a> : label}</span>{trailingSpace && ' '}
