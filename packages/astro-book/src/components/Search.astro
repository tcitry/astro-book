---
import type { SearchConfig } from '../types';
interface Props { config?: SearchConfig; part?: 'trigger' | 'dialog'; label?: string; closeLabel?: string }
const { config = {}, part = 'trigger', label = 'Search', closeLabel = 'Close Esc' } = Astro.props;
---
{part === 'trigger' ? <div class="book-search"><div class="relative w-full">
  <input type="search" id="book-search-input" placeholder={config.placeholder ?? label} aria-label={label} maxlength="128" autocomplete="off" data-open-search />
  <button type="button" class="book-search-shortcut absolute right-[10px] top-1/2 -translate-y-1/2 cursor-pointer rounded border-0 bg-[#e5e5e5] px-[5px] py-[2px] font-sans text-xs font-bold text-[#606060]" data-open-search aria-label={`${label} (Command or Control K)`}>⌘+K</button>
</div></div> : <div id="search-container" data-pagefind-ignore data-book-search-config={JSON.stringify(config)}>
  <div id="search-dialog" role="dialog" aria-modal="true" aria-label={label} tabindex="-1">
    <div class="mb-2 flex justify-end"><button class="cursor-pointer border-0 bg-transparent px-2 py-1 font-[inherit] text-inherit" type="button" data-close-search aria-label={closeLabel}>{closeLabel}</button></div>
    <div id="search"><p role="status" class="text-[var(--body-font-color)]">{config.loadingMessage ?? 'Enter a keyword to search'}</p></div>
  </div>
</div>}
