---
import BookLayout from '@tcitry/astro-book/components/BookLayout';
import PageNavigation from '@tcitry/astro-book/components/PageNavigation';
import type { Heading } from '@tcitry/astro-book/types';
import { navigation, pages, sourceRoot, withBase } from '../data/site';
interface Props {
  frontmatter?: { title?: string; description?: string };
  headings?: Heading[];
}
const { frontmatter = {}, headings = [] } = Astro.props;
const title = frontmatter.title ?? 'Astro Book';
const current = pages.findIndex((page) => withBase(page.slug) === Astro.url.pathname);
const pageLink = (index: number) => pages[index] ? { title: pages[index].title, url: withBase(pages[index].slug) } : undefined;
const previous = pageLink(current - 1);
const next = current >= 0 ? pageLink(current + 1) : undefined;
---
<BookLayout
  site={{ title: 'Astro Book', home: withBase(), lang: 'en' }}
  page={{ title, url: Astro.url.pathname, headings, description: frontmatter.description }}
  navigation={navigation(Astro.url.pathname)}
  search={{ placeholder: 'Search documentation', showImages: false }}
  seo={{ title: `${title} · Astro Book`, canonical: new URL(Astro.url.pathname, Astro.site).href, type: 'website' }}
  previous={previous}
  next={next}
>
  <Fragment slot="navigation-after">
    <hr />
    <p><a href="https://github.com/tcitry/astro-book">GitHub ↗</a></p>
    <p>
      <label for="example-theme">Appearance </label>
      <select id="example-theme" data-book-theme-select>
        <option value="auto">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
    </p>
  </Fragment>
  <article class="markdown" data-pagefind-body>
    <h1 data-pagefind-meta="title">{title}</h1>
    <slot />
  </article>
  <Fragment slot="footer">
    <PageNavigation previous={previous} next={next} />
    <p><a href={`${sourceRoot}/src/pages/${pages[current]?.file ?? 'index.astro'}`}>View this page on GitHub</a> · Theme and examples: MIT</p>
  </Fragment>
</BookLayout>
